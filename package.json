    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "esbuild": true
  }
