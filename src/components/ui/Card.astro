---
interface Props {
  variant?: 'default' | 'glass';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses = {
  default:
    'bg-surface border border-border hover:border-accent/40 focus-within:border-accent shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] hover:shadow-[0_10px_30px_-14px_color-mix(in_srgb,var(--color-accent)_40%,transparent)]',
  glass:
    'bg-surface-glass backdrop-blur-xl border border-border hover:border-accent/40 focus-within:border-accent',
};
---

<div
  class={`rounded-lg border transition duration-150 hover:-translate-y-1 focus-within:-translate-y-1 ${variantClasses[variant]} ${className}`}
>
  <slot />
</div>
