---
interface Props {
  variant?: 'default' | 'glass';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses = {
  default:
    'bg-surface border border-border hover:border-border-hover shadow-[0_1px_3px_0_rgba(15,23,42,0.05)]',
  glass:
    'bg-surface-glass backdrop-blur-xl border border-border hover:border-border-hover',
};
---

<div
  class={`rounded-lg border transition-colors duration-150 hover:-translate-y-0.5 ${variantClasses[variant]} ${className}`}
>
  <slot />
</div>
