---
interface Props {
  label: string;
  title: string;
  description?: string;
  index?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
}

const { label, title, description, index, level = 2, class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-2 ${className}`} data-reveal>
  <div class="flex items-center gap-3">
    <span class="font-mono text-xs uppercase tracking-widest text-accent shrink-0">
      {index && <span class="mr-1.5 text-text-dim">{index}</span>}
      {label}
    </span>
    <span class="section-rule" aria-hidden="true"></span>
  </div>
  {
    level === 1 && (
      <h1 class="mt-1 font-display text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        {title}
      </h1>
    )
  }
  {
    level === 2 && (
      <h2 class="mt-1 font-display text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        {title}
      </h2>
    )
  }
  {
    level === 3 && (
      <h3 class="mt-1 font-display text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        {title}
      </h3>
    )
  }
  {
    description && (
      <p class="text-sm sm:text-base text-text-muted max-w-2xl leading-relaxed">{description}</p>
    )
  }
</div>
