---
interface Props {
  label: string;
  title: string;
  description?: string;
  class?: string;
}

const { label, title, description, class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-2 ${className}`}>
  <span class="font-mono text-xs uppercase tracking-widest text-accent dark:text-accent">
    {label}
  </span>
  <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-text dark:text-text">
    {title}
  </h2>
  {
    description && (
      <p class="text-sm sm:text-base text-text-muted dark:text-text-muted max-w-2xl leading-relaxed">
        {description}
      </p>
    )
  }
</div>
