---
import Card from './Card.astro';
import Tag from './Tag.astro';
import type { Certification } from '../../data/certifications';
import { formatMonthYear } from '../../utils/dates';

interface Props {
  certification: Certification;
}

const { certification } = Astro.props;

const statusLabels: Record<Certification['status'], { label: string; className: string }> = {
  active: {
    label: 'Obtenida',
    className:
      'text-green-800 border-green-800/40 bg-green-800/10 dark:text-green-400 dark:border-green-400/40 dark:bg-green-400/10',
  },
  'in-progress': { label: 'En curso', className: 'text-accent border-accent/40 bg-accent/10' },
  planned: { label: 'Próxima', className: 'text-accent border-accent/40 bg-accent/10' },
  expired: { label: 'Caducada', className: 'text-text-muted border-border bg-surface' },
};

const status = statusLabels[certification.status];

const ctaLabel =
  certification.status === 'active' ? 'Ver credencial' : 'Información sobre la certificación';
---

<Card class="p-5 sm:p-6 flex flex-col gap-3 h-full">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-sm font-semibold text-text leading-snug">{certification.name}</h3>
    <span
      class={`shrink-0 font-mono text-[0.625rem] uppercase tracking-widest px-2 py-1 rounded-full border ${status.className}`}
    >
      {status.label}
    </span>
  </div>

  <p class="font-mono text-xs text-text-dim">
    {certification.issuer}
    {certification.date && ` · ${formatMonthYear(certification.date)}`}
  </p>

  {
    certification.description && (
      <p class="text-xs text-text-muted leading-relaxed">{certification.description}</p>
    )
  }

  {
    certification.skills && certification.skills.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {certification.skills.map((skill) => (
          <Tag>{skill}</Tag>
        ))}
      </div>
    )
  }

  {
    certification.url && (
      <a
        href={certification.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-auto inline-flex items-center gap-1 font-mono text-xs text-accent hover:text-accent-hover transition-colors duration-150 focus-ring rounded-sm w-fit"
      >
        {ctaLabel}
        <svg
          class="w-3.5 h-3.5 opacity-70"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m3 21 4.5-4.5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 8h6v6" />
          <path stroke-linecap="round" stroke-linejoin="round" d="m12 12 6-6" />
        </svg>
      </a>
    )
  }
</Card>
