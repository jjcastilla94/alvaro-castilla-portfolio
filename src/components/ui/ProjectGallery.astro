---
interface Props {
  title: string;
  images: string[];
  class?: string;
}

const { title, images, class: className = '' } = Astro.props;
---

<div class={`grid grid-cols-1 sm:grid-cols-2 gap-4 ${className}`}>
  {
    images.map((img, i) => (
      <button
        type="button"
        data-gallery-item
        class="group relative overflow-hidden rounded border border-border bg-surface text-left transition-colors duration-200 hover:border-accent/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label={`Ampliar captura ${i + 1} del proyecto ${title}`}
      >
        <img
          src={img}
          alt={`${title} — captura ${i + 1}`}
          loading="lazy"
          class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
        <span
          aria-hidden="true"
          class="absolute inset-0 flex items-end justify-end p-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
        >
          <span class="inline-flex items-center gap-1.5 rounded-md bg-surface/80 backdrop-blur-sm border border-border px-2 py-1 text-[0.6875rem] font-mono text-text-dim">
            <svg
              class="w-3 h-3"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
              />
            </svg>
            Ampliar
          </span>
        </span>
      </button>
    ))
  }
</div>

<dialog
  data-gallery-dialog
  class="gallery-dialog m-auto w-[min(92vw,1100px)] rounded-xl border border-border bg-bg/95 backdrop-blur-xl p-0 shadow-2xl"
>
  <div
    class="sticky top-0 flex items-center justify-between gap-4 px-5 sm:px-6 py-3 border-b border-border bg-surface"
  >
    <span class="font-mono text-xs uppercase tracking-widest text-text-dim">{title}</span>
    <button
      type="button"
      data-gallery-close
      class="inline-flex items-center justify-center w-8 h-8 rounded-md border border-border text-text-muted hover:text-text hover:border-border-hover transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Cerrar visualización ampliada"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div class="relative flex items-center px-4 sm:px-6 py-6">
    <button
      type="button"
      data-gallery-prev
      class="absolute left-2 sm:left-4 z-10 inline-flex items-center justify-center w-9 h-9 rounded-full border border-border bg-surface/90 text-text-muted hover:text-text transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Imagen anterior"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 19-7-7 7-7"></path>
      </svg>
    </button>

    <img data-lightbox-img alt="" class="mx-auto max-h-[70vh] w-auto rounded-md" />

    <button
      type="button"
      data-gallery-next
      class="absolute right-2 sm:right-4 z-10 inline-flex items-center justify-center w-9 h-9 rounded-full border border-border bg-surface/90 text-text-muted hover:text-text transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Imagen siguiente"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"></path>
      </svg>
    </button>
  </div>
</dialog>

<script>
  interface GalleryDialogElement extends HTMLDialogElement {
    dataset: DOMStringMap;
  }

  function galleryItems(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-item]'));
  }

  function currentDialog(): GalleryDialogElement | null {
    return document.querySelector<GalleryDialogElement>('[data-gallery-dialog]');
  }

  function showImage(dialog: GalleryDialogElement, index: number): void {
    const items = galleryItems();
    const item = items[index];
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]');
    if (!item || !img || !dialog) return;
    const itemImg = item.querySelector<HTMLImageElement>('img');
    img.src = itemImg?.src ?? '';
    img.alt = itemImg?.alt ?? '';
    dialog.dataset.index = String(index);
    dialog.showModal();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const item = target.closest<HTMLElement>('[data-gallery-item]');
    if (!item) return;

    const dialog = currentDialog();
    if (!dialog) return;

    const index = galleryItems().indexOf(item);
    if (index >= 0) showImage(dialog, index);
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const dialog = currentDialog();
    if (!dialog || !dialog.open) return;

    if (target.closest('[data-gallery-close]')) {
      dialog.close();
      return;
    }
    if (target.closest('[data-gallery-prev]')) {
      const count = galleryItems().length;
      const current = parseInt(dialog.dataset.index || '0', 10);
      showImage(dialog, (current - 1 + count) % count);
      return;
    }
    if (target.closest('[data-gallery-next]')) {
      const count = galleryItems().length;
      const current = parseInt(dialog.dataset.index || '0', 10);
      showImage(dialog, (current + 1) % count);
      return;
    }
    if (target === dialog) {
      dialog.close();
    }
  });
</script>
