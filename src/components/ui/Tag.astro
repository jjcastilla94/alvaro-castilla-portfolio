---
interface Props {
  variant?: 'default' | 'accent';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses = {
  default:
    'bg-surface-hover border border-border text-text-muted',
  accent:
    'bg-accent-subtle border border-accent/25 text-accent',
};
---

<span
  class={`inline-flex items-center px-2.5 py-1 rounded text-[0.8125rem] font-mono border ${variantClasses[variant]} ${className}`}
>
  <slot />
</span>
