---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href = '#',
  variant = 'primary',
  size = 'md',
  type = 'button',
  external = false,
  class: className = '',
  'aria-label': ariaLabel,
} = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';

const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs',
  md: 'px-4 py-2 text-sm',
  lg: 'px-6 py-3 text-sm',
};

const variantClasses = {
  primary:
    'bg-accent text-white hover:bg-accent-hover shadow-[inset_0_1px_0_rgba(255,255,255,0.12)]',
  secondary:
    'border border-border bg-surface text-text hover:bg-surface-hover hover:border-border-hover',
  ghost: 'text-text-muted hover:text-text hover:bg-surface-hover',
};
---

{
  href ? (
    <a
      href={href}
      class={`${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`}
      aria-label={ariaLabel}
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={`${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
