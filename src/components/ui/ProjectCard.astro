---
import Tag from './Tag.astro';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  technologies: string[];
  href: string;
  github?: string;
  color: string;
  index: number;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  technologies,
  href,
  github,
  color,
  index,
  class: className = '',
} = Astro.props;

const gradientMap: Record<string, string> = {
  arcadia: 'from-violet-600/20 via-blue-600/10 to-indigo-800/20',
  detubarrio: 'from-orange-500/20 via-amber-500/10 to-yellow-600/20',
};

const patternMap: Record<string, string> = {
  arcadia: `
    background-image:
      radial-gradient(circle at 1px 1px, rgba(139,92,246,0.15) 1px, transparent 0);
    background-size: 24px 24px;
  `,
  detubarrio: `
    background-image:
      radial-gradient(circle at 1px 1px, rgba(249,115,22,0.12) 1px, transparent 0);
    background-size: 28px 28px;
  `,
};

const gradient = gradientMap[color] || 'from-accent/10 via-surface to-accent/5';
const pattern = patternMap[color] || '';
---

<a
  href={href}
  class={`project-card block rounded-xl border border-border bg-surface group ${className}`}
>
  <div
    class={`project-preview relative h-44 sm:h-52 rounded-t-xl overflow-hidden bg-gradient-to-br ${gradient}`}
  >
    <div class="absolute inset-0" style={pattern}></div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"
    >
    </div>
    <div class="absolute top-4 right-4 font-mono text-5xl font-bold text-white/[0.04] select-none">
      {String(index).padStart(2, '0')}
    </div>
    <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between">
      <div>
        <h3 class="text-xl font-bold text-text">{title}</h3>
        <p class="font-mono text-xs text-text-dim mt-0.5">{subtitle}</p>
      </div>
      <span
        class="project-arrow inline-flex items-center justify-center w-8 h-8 rounded-full border border-border bg-surface/80 text-text-muted group-hover:text-accent group-hover:border-accent/40 transition-all duration-200"
      >
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
        </svg>
      </span>
    </div>
  </div>

  <div class="project-content p-5 sm:p-6 flex flex-col gap-3">
    <p class="text-sm text-text-muted leading-relaxed">{description}</p>
    <div class="flex flex-wrap gap-1.5">
      {technologies.map((tech) => <Tag>{tech}</Tag>)}
    </div>
    <div class="flex items-center gap-3 mt-1">
      <span class="text-xs text-accent font-medium group-hover:underline">
        Ver caso de estudio
      </span>
      {github && <span class="text-xs text-text-dim">·</span>}
      {github && <span class="text-xs text-text-dim">GitHub ↗</span>}
    </div>
  </div>
</a>
