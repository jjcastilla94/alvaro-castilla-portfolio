---
const TOGGLE_ID = 'theme-toggle';
---

<button
  id={TOGGLE_ID}
  type="button"
  class="p-2 rounded-lg border border-border text-text-muted hover:text-text hover:border-border-hover transition-colors duration-150 focus-ring"
  aria-label="Cambiar tema"
  title="Cambiar tema"
>
  <svg
    class="w-5 h-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0-1.414-1.414M7.05 7.05 5.636 5.636M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"
    ></path>
  </svg>
  <svg
    class="w-5 h-5 hidden dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
    ></path>
  </svg>
</button>

<script>
  // Event delegation bound once on the document: survives View Transition
  // navigation, where the header (and its #theme-toggle button) is re-created
  // on every page but module scripts are evaluated only once.
  document.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    if (!target || !target.closest('#theme-toggle')) return;

    const root = document.documentElement;
    const currentTheme = root.classList.contains('light') ? 'light' : 'dark';
    const nextTheme = currentTheme === 'light' ? 'dark' : 'light';

    root.classList.remove(currentTheme);
    root.classList.add(nextTheme);
    localStorage.setItem('theme', nextTheme);
  });
</script>
