---
const YEAR = new Date().getFullYear();
---

<footer class="w-full border-t border-border py-10 px-6 sm:px-8">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2 font-mono text-xs text-text-dim">
      <span>© {YEAR} Álvaro Castilla</span>
      <span aria-hidden="true">•</span>
      <span>Backend Developer</span>
    </div>
    <div class="flex items-center gap-6 font-mono text-xs">
      <a
        href="https://github.com/jjcastilla94"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-dim hover:text-text transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/alvarocastillagonzalez"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-dim hover:text-text transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        LinkedIn
      </a>
      <a
        href="#top"
        class="text-text-dim hover:text-text transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Volver arriba ↑
      </a>
    </div>
  </div>
</footer>
