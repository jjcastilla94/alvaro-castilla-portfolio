---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Tag from '../../components/ui/Tag.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ProjectStatus from '../../components/ui/ProjectStatus.astro';
import ProjectGallery from '../../components/ui/ProjectGallery.astro';

import { PROJECTS, getProjectRepos } from '../../data/projects';
import { PROFILE } from '../../data/profile';
import { SITE } from '../../data/site';
import { getProjectImages } from '../../utils/projectImages';
import { getProjectGradient, getProjectPattern } from '../../data/projectStyles';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;
const project = PROJECTS.find((p) => p.id === slug);

if (!project) {
  throw new Error(`No se encontró el proyecto con slug "${slug}"`);
}

const projectImages = getProjectImages(project.id);
const image = project.image ?? projectImages[0];
const gallery = project.gallery && project.gallery.length > 0 ? project.gallery : projectImages;
const repos = getProjectRepos(project);

const title = `${project.title} — ${PROFILE.name}`;
const description = project.longDescription ?? project.description;

const gradient = getProjectGradient(project.color);
const pattern = getProjectPattern(project.color);

const detailSections = [
  { id: 'problem', label: 'El problema', text: project.problem },
  { id: 'contribution', label: 'Mi contribución', text: project.contribution },
  { id: 'learnings', label: 'Lo que aprendí', text: project.learnings },
].filter((section) => section.text !== undefined);
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE.url}/projects/${project.id}`}
>
  <section class="max-w-6xl mx-auto px-6 sm:px-8 pt-32 sm:pt-40 pb-16">
    <Breadcrumbs crumbs={[{ href: '/projects', label: 'Proyectos' }, { label: project.title }]} />

    <div
      class={`mt-8 relative h-48 sm:h-72 rounded-xl overflow-hidden bg-gradient-to-br ${gradient} border border-border`}
    >
      <div class="absolute inset-0" style={pattern}></div>
      {image && (
        <img
          src={image}
          alt={`${project.title} — captura`}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover object-top"
        />
      )}
    </div>

    <div data-reveal class="mt-6 flex flex-wrap items-center gap-2">
      {project.status && <ProjectStatus status={project.status} />}
    </div>

    <header data-reveal class="mt-3">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-text">
        {project.title}
      </h1>
      <p class="mt-2 font-mono text-sm text-accent">
        {project.subtitle}
      </p>
    </header>

    {
      project.technologies.length > 0 && (
        <div data-reveal style="--reveal-delay: 60ms" class="mt-6 flex flex-wrap gap-1.5">
          {project.technologies.map((tech) => (
            <Tag variant="accent">{tech}</Tag>
          ))}
        </div>
      )
    }

    <div data-reveal style="--reveal-delay: 120ms" class="mt-8">
      <Card class="p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-text">Acerca del proyecto</h2>
        <p class="mt-4 text-sm text-text-muted leading-relaxed">
          {project.longDescription || project.description}
        </p>
      </Card>
    </div>

    {
      detailSections.length > 0 && (
        <div data-reveal style="--reveal-delay: 160ms" class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            detailSections.map((section, i) => (
              <Card class="p-6 sm:p-7">
                <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-2 text-base font-semibold text-text">{section.label}</h3>
                <p class="mt-2 text-sm text-text-muted leading-relaxed">{section.text}</p>
              </Card>
            ))
          }
        </div>
      )
    }

    {
      gallery.length > 0 && (
        <div data-reveal style="--reveal-delay: 200ms" class="mt-8">
          <Card class="p-4 sm:p-6">
            <h2 class="text-lg font-semibold text-text">Galería</h2>
            <p class="mt-1 text-xs text-text-muted">
              Pulsa en una captura para ampliarla.
            </p>
            <ProjectGallery title={project.title} images={gallery} class="mt-4" />
          </Card>
        </div>
      )
    }

    <div data-reveal style="--reveal-delay: 240ms" class="mt-8 flex flex-wrap gap-4">
      {
        project.url && (
          <Button href={project.url} external>
            Visitar proyecto
          </Button>
        )
      }
      {
        repos.map((repo) => (
          <Button href={repo.url} external>
            {repo.label === 'GitHub' ? 'Ver en GitHub' : repo.label}
          </Button>
        ))
      }
      {
        !project.url && repos.length > 0 && (
          <span class="inline-flex items-center gap-2 font-mono text-xs text-text-dim">
            Disponible en GitHub · sin despliegue en producción todavía
          </span>
        )
      }
      <Button href="/projects" variant="secondary">Volver a proyectos</Button>
    </div>
  </section>
</BaseLayout>