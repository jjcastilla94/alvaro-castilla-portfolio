---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Reveal from '../components/ui/Reveal.astro';
import Tag from '../components/ui/Tag.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Architecture from '../components/sections/Architecture.astro';

import { PROFILE } from '../data/profile';
import { EXPERIENCE } from '../data/experience';
import { PROJECTS } from '../data/projects';
import { SKILLS } from '../data/skills';
import { CAPABILITIES } from '../data/services';
import { formatDate } from '../utils/dates';

const title = `${PROFILE.name} — ${PROFILE.role}`;
const description = PROFILE.bio;

const currentExperience = EXPERIENCE.find((e) => e.endDate === null);
---

<BaseLayout title={title} description={description}>
  <Hero />

  <!-- ===== ABOUT ===== -->
  <About />

  <!-- ===== EXPERIENCE ===== -->
  <section id="experience" class="max-w-6xl mx-auto px-6 sm:px-8 py-16">
    <SectionHeading
      index="02"
      label="Experiencia profesional"
      title="Donde aplico lo que sé"
      description="Mi experiencia profesional en desarrollo backend, trabajando en el desarrollo y mantenimiento de APIs REST en entornos empresariales."
      class="border-b border-border pb-8"
    />

    {
      currentExperience && (
        <Reveal class="mt-10" delay={40}>
          <Card class="p-6 sm:p-8">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
              <div>
                <h3 class="font-display text-lg sm:text-xl font-semibold text-text">
                  {currentExperience.role}
                </h3>
                <p class="mt-1 font-mono text-xs text-text-dim">
                  {currentExperience.company} · Departamento de {currentExperience.department} ·{' '}
                  {formatDate(currentExperience.startDate)} — actualidad
                </p>
              </div>
            </div>
            <p class="mt-4 text-sm text-text-muted leading-relaxed">
              {currentExperience.description}
            </p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {currentExperience.technologies.map((tech) => (
                <Tag>{tech}</Tag>
              ))}
            </div>
          </Card>
        </Reveal>
      )
    }

    <div data-reveal class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3">
      {
        PROFILE.stats.map((stat, i) => (
          <div
            class="flex flex-col gap-1 p-4 rounded-lg border border-border bg-surface/60 hover:border-accent/40 transition-colors duration-200"
            data-stat
            data-count={stat.countTo ?? ''}
            data-value={stat.value}
            data-suffix={stat.suffix ?? ''}
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <span class="stat-num text-2xl">
              <span class="stat-count">{stat.value}</span>
              {stat.suffix && <span class="stat-suffix text-base ml-0.5">{stat.suffix}</span>}
            </span>
            <span class="text-xs text-text-muted leading-tight">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <div data-reveal class="mt-8">
      <Button href="/experience" variant="ghost">
        Ver experiencia completa
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">→</span
        >
      </Button>
    </div>
  </section>

  <!-- ===== PROJECTS ===== -->
  <section class="max-w-6xl mx-auto px-6 sm:px-8 py-16">
    <SectionHeading
      index="03"
      label="Proyectos"
      title="Lo que he construido"
      description="Proyectos Full Stack que demuestran mi capacidad técnica en el stack backend y su integración con el frontend."
      class="border-b border-border pb-8"
    />

    <div class="mt-10 grid grid-cols-1 gap-6">
      {
        PROJECTS.map((project, i) => (
          <Reveal class="h-full" delay={i * 80}>
            <ProjectCard
              title={project.title}
              subtitle={project.subtitle}
              description={project.description}
              technologies={project.technologies}
              href={project.href}
              github={project.github}
              color={project.color}
              index={i + 1}
            />
          </Reveal>
        ))
      }
    </div>

    <div data-reveal class="mt-8">
      <Button href="/projects" variant="ghost">
        Ver todos los proyectos
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">→</span
        >
      </Button>
    </div>
  </section>

  <!-- ===== ARCHITECTURE ===== -->
  <Architecture />

  <!-- ===== SKILLS ===== -->
  <section class="max-w-6xl mx-auto px-6 sm:px-8 py-16">
    <SectionHeading
      index="05"
      label="Skills"
      title="Mi stack técnico"
      description="Diferencio entre las tecnologías que definen mi perfil, las que manejo con soltura y las áreas en las que estoy creciendo."
      class="border-b border-border pb-8"
    />

    <div class="mt-10 flex flex-col gap-8">
      {
        SKILLS.map((group, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 70}ms`} class="flex flex-col gap-3">
            <div class="flex flex-col gap-1">
              <span
                class={`font-mono text-xs uppercase tracking-widest ${
                  group.level === 'core' ? 'text-accent' : 'text-text-dim'
                }`}
              >
                <span class="mr-1.5 text-text-dim">{String(i + 1).padStart(2, '0')}</span>
                {group.label}
              </span>
              <span class="text-xs text-text-muted">{group.description}</span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {group.skills.map((skill) => (
                <Tag variant={group.level === 'core' ? 'accent' : 'default'}>{skill}</Tag>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== WHAT I BUILD ===== -->
  <section class="max-w-6xl mx-auto px-6 sm:px-8 py-16">
    <SectionHeading
      index="06"
      label="Lo que construyo"
      title="Áreas donde puedo aportar"
      description="La combinación de mi stack técnico y mi forma de trabajar me permite contribuir en varias áreas del desarrollo de software."
      class="border-b border-border pb-8"
    />

    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        CAPABILITIES.map((cap, i) => (
          <Reveal class="h-full" delay={i * 80}>
            <ServiceCard
              title={cap.title}
              description={cap.description}
              technologies={cap.technologies}
              index={i + 1}
            />
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="glow-accent relative max-w-6xl mx-auto px-6 sm:px-8 py-16">
    <div data-reveal>
      <Card variant="glass" class="p-8 sm:p-12 text-center">
        <span class="font-mono text-xs uppercase tracking-widest text-accent">07 · Contacto</span>
        <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-text">¿Hablamos?</h2>
        <p class="mt-3 text-sm sm:text-base text-text-muted max-w-xl mx-auto leading-relaxed">
          Dispuesto a colaborar, aprender y crecer como profesional del desarrollo de software.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={`mailto:${PROFILE.email}`}>Contáctame por email</Button>
          <Button href="/contact" variant="secondary">Ver contacto</Button>
        </div>
      </Card>
    </div>
  </section>
</BaseLayout>