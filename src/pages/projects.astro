---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/ui/Reveal.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';

import { PROJECTS, getProjectPrimaryRepo } from '../data/projects';
import { PROFILE } from '../data/profile';
import { SITE } from '../data/site';
import { getProjectMainImage } from '../utils/projectImages';
import { pageSchema } from '../utils/seo';

const title = `Proyectos — ${PROFILE.name}`;
const description =
  'Proyectos de Alvaro Castilla con Spring Boot, Vue, Docker y CI/CD: casos de estudio técnicos, galería de capturas y enlaces a GitHub y demos en producción.';

const jsonLd = pageSchema({
  path: '/projects',
  name: title,
  description,
  type: 'CollectionPage',
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE.url}/projects`}
  ogImage="/og/projects.png"
  jsonLd={jsonLd}
>
  <section class="max-w-6xl mx-auto px-6 sm:px-8 pt-32 sm:pt-40 pb-16">
    <Breadcrumbs crumbs={[{ label: 'Proyectos' }]} />
    <SectionHeading
      index="01"
      label="Proyectos"
      title="Lo que he construido"
      description="Proyectos full-stack en los que he trabajado tanto en backend como en frontend, con foco en la integración entre sistemas."
      level={1}
      class="border-b border-border pb-8"
    />

    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        PROJECTS.map((project, i) => (
          <Reveal class="h-full" delay={i * 80}>
            <ProjectCard
              title={project.title}
              subtitle={project.subtitle}
              description={project.description}
              technologies={project.technologies}
              href={project.href}
              url={project.url}
              color={project.color}
              image={project.image ?? getProjectMainImage(project.id)}
              github={getProjectPrimaryRepo(project)?.url}
              status={project.status}
              index={i + 1}
              headingLevel={2}
            />
          </Reveal>
        ))
      }
    </div>
  </section>
</BaseLayout>
