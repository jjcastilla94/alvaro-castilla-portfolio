---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Reveal from '../components/ui/Reveal.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SocialLink from '../components/ui/SocialLink.astro';

import { PROFILE, hasCv } from '../data/profile';
import { SITE } from '../data/site';
import { pageSchema } from '../utils/seo';

const title = `Contacto — ${PROFILE.name}`;
const description =
  'Contacto de Alvaro Castilla: email, GitHub y LinkedIn. Hablemos de desarrollo de software, proyectos o oportunidades como Backend Developer.';

const jsonLd = pageSchema({
  path: '/contact',
  name: title,
  description,
  type: 'ContactPage',
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE.url}/contact`}
  ogImage="/og/contact.png"
  jsonLd={jsonLd}
>
  <section class="max-w-6xl mx-auto px-6 sm:px-8 pt-32 sm:pt-40 pb-16">
    <Breadcrumbs crumbs={[{ label: 'Contacto' }]} />
    <SectionHeading
      index="01"
      label="Contacto"
      title="¿Hablamos?"
      description="Escríbeme directamente o conéctate conmigo por redes."
      level={1}
      class="border-b border-border pb-8"
    />

    <Reveal class="mt-10" delay={0}>
      <Card class="p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
          {
            PROFILE.image && (
              <Image
                src={PROFILE.image}
                alt={`${PROFILE.name} — fotografía`}
                width={224}
                height={224}
                class="w-28 h-28 shrink-0 rounded-full object-cover border border-border"
              />
            )
          }
          <div class="flex flex-col gap-2">
            <h2 class="text-xl font-semibold text-text">{PROFILE.name}</h2>
            <p class="font-mono text-xs text-accent">{PROFILE.role}</p>
            <div class="flex flex-wrap gap-3 mt-1">
              <Button href={`mailto:${PROFILE.email}`}>Escribirme</Button>
              {
                hasCv() && (
                  <Button href={PROFILE.cvUrl} external variant="secondary">
                    Descargar CV
                  </Button>
                )
              }
            </div>
          </div>
        </div>
      </Card>
    </Reveal>

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
      <Reveal class="h-full" delay={40}>
        <Card class="p-6 sm:p-8 h-full">
          <div class="flex flex-col gap-4 h-full">
            <div>
              <h3 class="font-semibold text-text">Email</h3>
              <p class="mt-1 text-sm text-text-muted leading-relaxed">
                Para propuestas laborales, colaboraciones o cualquier consulta.
              </p>
              <p class="mt-3 font-mono text-xs text-text-dim break-all">
                {PROFILE.email}
              </p>
            </div>
            <div class="flex-1 flex items-end">
              <Button href={`mailto:${PROFILE.email}`}>Escribirme</Button>
            </div>
          </div>
        </Card>
      </Reveal>

      <Reveal class="h-full" delay={100}>
        <Card class="p-6 sm:p-8 h-full">
          <div class="flex flex-col gap-4 h-full">
            <div>
              <h3 class="font-semibold text-text">GitHub</h3>
              <p class="mt-1 text-sm text-text-muted leading-relaxed">
                Código de mis proyectos y contribuciones.
              </p>
            </div>
            <div class="flex-1 flex items-end">
              <Button href={PROFILE.social.github} external variant="secondary"
                >Ver perfil de GitHub</Button
              >
            </div>
          </div>
        </Card>
      </Reveal>

      <Reveal class="h-full" delay={160}>
        <Card class="p-6 sm:p-8 h-full">
          <div class="flex flex-col gap-4 h-full">
            <div>
              <h3 class="font-semibold text-text">LinkedIn</h3>
              <p class="mt-1 text-sm text-text-muted leading-relaxed">
                Trayectoria profesional y conexiones.
              </p>
            </div>
            <div class="flex-1 flex items-end">
              <Button href={PROFILE.social.linkedin} external variant="secondary"
                >Ver perfil de LinkedIn</Button
              >
            </div>
          </div>
        </Card>
      </Reveal>

      <Reveal class="h-full" delay={220}>
        <Card class="p-6 sm:p-8 h-full">
          <div class="flex flex-col gap-4 h-full">
            <div>
              <h3 class="font-semibold text-text">Redes</h3>
              <p class="mt-1 text-sm text-text-muted leading-relaxed">
                Accesos directos a mis perfiles profesionales.
              </p>
            </div>
            <div class="flex-1 flex items-end">
              <div class="flex items-center gap-6">
                <SocialLink href={PROFILE.social.github} label="GitHub" class="text-sm" />
                <SocialLink href={PROFILE.social.linkedin} label="LinkedIn" class="text-sm" />
              </div>
            </div>
          </div>
        </Card>
      </Reveal>
    </div>
  </section>
</BaseLayout>
